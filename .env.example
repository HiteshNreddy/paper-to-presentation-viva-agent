# ─────────────────────────────────────────────────────────────────────────────
# Paper-to-Presentation & Viva Agent — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to ".env"  (cp .env.example .env  or  copy .env.example .env)
# 2. Fill in the values below.
# 3. NEVER commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key — obtain from https://aistudio.google.com/app/apikey
# langchain-google-genai reads GOOGLE_API_KEY automatically.
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini model name to use for generation
GEMINI_MODEL=gemini-3.8-flash

# Gemini client transport ('rest' or 'grpc'). 'rest' uses HTTPS over port 443, preventing Windows gRPC hangs.
GEMINI_TRANSPORT=rest

# Gemini request timeout in seconds (prevents hanging if connection or proxy drops)
GEMINI_REQUEST_TIMEOUT=30.0

# Embedding model (runs locally — no API key required)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory (relative to project root)
CHROMA_PERSIST_DIR=./chroma_store

# ChromaDB collection name — one collection per session keeps papers isolated
CHROMA_COLLECTION_NAME=paper_chunks

# Maximum number of text chunks retrieved from the vector store per query
RAG_TOP_K=5

# Chunk size and overlap for PDF text splitting (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Maximum LLM retry attempts on malformed structured output
LLM_MAX_RETRIES=2
